# Edge Function secrets for the Puzzlr publish path.
#
# Copy this file to `supabase/functions/.env` (which is gitignored via the *.env
# / .env rules) for LOCAL function runs, and set the same values on the hosted
# project with:
#
#   supabase secrets set PUZZLR_API_KEY=your-key
#   supabase secrets set PUZZLR_GAME_ID=30454bd0-3a84-4ea0-8d6f-9ef560d8f31a   # optional
#
# The key NEVER reaches the browser — it lives only here / in Supabase secrets,
# server-side. The browser calls the publish-puzzle function, which holds the key
# and calls Puzzlr on the caller's behalf.

# Your Puzzlr management API key (Configuration -> Public API in the live CMS).
PUZZLR_API_KEY=your-puzzlr-api-key-here

# Optional: the Puzzlr game id. Falls back to the Relink default when unset.
PUZZLR_GAME_ID=30454bd0-3a84-4ea0-8d6f-9ef560d8f31a

# ── Admin user management (admin-invite-user / admin-list-users) ─────────────
# These functions use the Supabase Admin API, which needs the service-role key.
# You do NOT set this yourself: Supabase auto-injects SUPABASE_SERVICE_ROLE_KEY
# (plus SUPABASE_URL and SUPABASE_ANON_KEY) into every Edge Function at runtime.
# `supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...` is REJECTED — the SUPABASE_
# prefix is reserved. The key is read from Deno.env server-side and NEVER reaches
# the browser. Nothing to add here for these functions.
